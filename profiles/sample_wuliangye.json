{
  "project_id": "wuliangye_line_a",
  "database": {
    "type": "sqlite",
    "path": "D:/Device/Data/log.db",
    "readonly": true
  },
  "entities": {
    "inspection_item": {
      "table": "detect_result",
      "time": "create_time",
      "camera_id": "camera_uuid",
      "trigger_id": "trigger_id",
      "is_ok": "is_ok",
      "defect_code": "result_code",
      "confidence": "score",
      "model_version": "model_version",
      "image_path": "image_path"
    },
    "defect_instance": {
      "table": "defect_box",
      "join": "defect_box.result_id = detect_result.id",
      "defect_code": "defect_type",
      "confidence": "confidence",
      "bbox_x": "x",
      "bbox_y": "y",
      "bbox_w": "w",
      "bbox_h": "h"
    }
  },
  "defect_dictionary": {
    "OK": "正常",
    "HD": "黑点",
    "ZW": "脏污",
    "QL": "缺料"
  },
  "thresholds": {
    "ng_rate_warn": 0.05,
    "infer_p95_ms_warn": 900,
    "confidence_low_warn": 0.45,
    "continuous_ng_warn": 5
  }
}

